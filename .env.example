# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pet_nutra_intel
DB_ECHO=false

# Scraping
SCRAPE_RATE_LIMIT_SECONDS=2.0
SCRAPE_MAX_RETRIES=3
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_USER_AGENT=PetNutraIntel/1.0 (market-research; contact@alfavet.de)
SCRAPE_POLITE_CONCURRENCY=2

# Sources
ALFAVET_BASE_URL=https://alfavet.de/
CHEWY_BASE_URL=https://www.chewy.com/

# Scheduler
WEEKLY_SCHEDULE_DAY=monday
WEEKLY_SCHEDULE_HOUR=6
WEEKLY_SCHEDULE_MINUTE=0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pet_nutra_intel.log

# Feature flags (disable a source if access rules require it)
SOURCE_ALFAVET_ENABLED=true
SOURCE_CHEWY_ENABLED=true
